#!/usr/bin/env bash
# Pre-commit checks for the Resonators archive (see AGENTS.md §6).
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

PY=.venv/bin/python
[ -x "$PY" ] || PY=python3
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
fail=0

# 1. JSON data must parse.
for f in $(printf '%s\n' "$staged" | grep -E '^data/.*\.json$' || true); do
  "$PY" -m json.tool "$f" >/dev/null || { echo "✗ JSON không hợp lệ: $f"; fail=1; }
done

# 2. Data changed -> review.py must pass, and meta must be bumped.
if printf '%s\n' "$staged" | grep -qE '^data/|^scripts/'; then
  echo "→ python scripts/review.py"
  out=$(mktemp)
  "$PY" scripts/review.py >"$out" 2>&1 || { tail -20 "$out"; echo "✗ review.py FAIL"; fail=1; }
  rm -f "$out"
fi
if printf '%s\n' "$staged" | grep -qx 'data/characters.json' && git cat-file -e HEAD:data/characters.json 2>/dev/null; then
  "$PY" - <<'PY' || fail=1
import json, os, subprocess, sys
# In-game info = everything except Vietnamese translations and the history itself.
# Translation fixes (desc_vi, intro_vi) are not game changes and need no entry.
VI_KEYS = {'desc_vi', 'intro_vi', 'changes', 'version', 'updated', 'references',
           # where an image is hosted (remote URL vs public/assets copy) is not in-game info
           'icon', 'img', 'img_icon', 'img_card', 'img_full'}  # not in-game info
def game_info(x):
    if isinstance(x, dict):
        return {k: game_info(v) for k, v in x.items() if k not in VI_KEYS}
    if isinstance(x, list):
        return [game_info(v) for v in x]
    return x
allow_rewrite = os.environ.get('ALLOW_HISTORY_REWRITE') == '1'
def differs(new, old):
    """True when in-game info present in both versions changed. Fields that only
    exist in one version (newly added data, at any depth) are ignored."""
    if isinstance(new, dict) and isinstance(old, dict):
        return any(differs(new[k], old[k]) for k in (set(new) & set(old)) - VI_KEYS)
    if isinstance(new, list) and isinstance(old, list):
        return len(new) != len(old) or any(differs(a, b) for a, b in zip(new, old))
    return new != old
new = json.loads(subprocess.check_output(['git', 'show', ':data/characters.json']))
old = json.loads(subprocess.check_output(['git', 'show', 'HEAD:data/characters.json']))
olds = {c['slug']: c for c in old['characters']}
bad = []
for c in new['characters']:
    o = olds.get(c['slug'])
    if o is None:
        continue
    # Only fields present before and after count: adding a new field (filling in
    # data the archive lacked, e.g. resonance_chain) is not an in-game change.
    if differs(c, o) and len(c.get('changes', [])) <= len(o.get('changes', [])):
        bad.append(c['slug'])
    if not allow_rewrite and o.get('changes', []) != c.get('changes', [])[:len(o.get('changes', []))]:
        print(f"✗ {c['slug']}: lịch sử changes cũ bị sửa/xóa (chỉ được thêm entry mới)"); sys.exit(1)
if bad:
    print('✗ Thông tin game của nhân vật đổi nhưng thiếu entry mới trong changes:', ', '.join(bad)); sys.exit(1)
import datetime
today = datetime.date.today().isoformat()
if new != old and new['meta'].get('updated') != today:
    print(f"✗ data/characters.json đổi nhưng meta.updated chưa là ngày hôm nay ({today})"); sys.exit(1)
PY
fi

# 2b. Tests (pytest from requirements-dev.txt) when data, scripts, app or tests change.
if printf '%s\n' "$staged" | grep -qE '^(data|scripts|app|tests)/'; then
  if "$PY" -c 'import pytest' 2>/dev/null; then
    echo "→ pytest"
    out=$(mktemp)
    "$PY" -m pytest -q -p no:cacheprovider tests >"$out" 2>&1 || { tail -25 "$out"; echo "✗ pytest FAIL"; fail=1; }
    rm -f "$out"
  else
    echo "! pytest chưa cài: .venv/bin/pip install -r requirements-dev.txt"
  fi
fi

# 3. Frontend/backend syntax.
for f in $(printf '%s\n' "$staged" | grep -E '^public/.*\.js$' || true); do
  node --check "$f" || { echo "✗ Lỗi cú pháp JS: $f"; fail=1; }
done
for f in $(printf '%s\n' "$staged" | grep -E '\.py$' || true); do
  "$PY" -m py_compile "$f" || { echo "✗ Lỗi cú pháp Python: $f"; fail=1; }
done

# 4. No generated/local files.
if printf '%s\n' "$staged" | grep -qE '(^|/)(\.venv|__pycache__|\.playwright-cli)/|^data/en_raw\.json$'; then
  echo "✗ Đang stage file sinh tự động/local (.venv, __pycache__, en_raw.json...)"; fail=1
fi

[ "$fail" -eq 0 ] && echo "✓ pre-commit OK" || { echo "Commit bị chặn. Sửa lỗi trên rồi commit lại."; exit 1; }
